<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:layout_width="match_parent"
  android:layout_height="wrap_content"
  android:orientation="vertical">

  <CheckBox
    android:id="@+id/ceiling_water_enabled"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:text="@string/water_depth" />

  <EditText
    android:id="@+id/ceiling_water_depth"
    style="@style/edit_text_light"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:hint="@string/water_depth"
    android:importantForAutofill="no"
    android:inputType="text"
    android:singleLine="true" />

  <include layout="@layout/drawing_special_point_typography" />
</LinearLayout>
