encoding utf-8
symbol line
name dashed_line_with_arrow
th_name u:dashed-line-with-arrow
group user
color 0x6699ff 0xff
width 2
# Reuse the standard Dashed line's 6-on/4-off rhythm in line-width units.
# Renderers without Sketch terminal support retain the base blue dashed line.
dash 6 4
sketch_effect 1
  carrier -0.5 0.5
  terminal end inset 6
  terminal_stamp
    moveTo -8 -4
    lineTo 0 0
    lineTo -8 4
    lineTo -6 0
    lineTo -8 -4
  endterminal_stamp
endsketch_effect
endsymbol
