# Default: auto-detect text, normalize to LF in the repo.
# With core.autocrlf=true on Windows, working-tree files still check out as CRLF.
* text=auto eol=lf

# Source / config / documentation — explicit LF
*.java       text eol=lf
*.kt         text eol=lf
*.xml        text eol=lf
*.gradle     text eol=lf
*.properties text eol=lf
*.pro        text eol=lf
*.cfg        text eol=lf
*.md         text eol=lf
*.glsl       text eol=lf
*.json       text eol=lf
*.html       text eol=lf
*.htm        text eol=lf
*.txt        text eol=lf
*.cof        text eol=lf
*.yml        text eol=lf
*.yaml       text eol=lf

# Windows-native tooling — keep CRLF so PowerShell / cmd don't choke
*.ps1        text eol=crlf
*.bat        text eol=crlf
*.cmd        text eol=crlf

# Binary — never munge
*.png        binary
*.jpg        binary
*.jpeg       binary
*.gif        binary
*.ico        binary
*.webp       binary
*.pdf        binary
*.ttf        binary
*.otf        binary
*.woff       binary
*.woff2      binary
*.zip        binary
*.jar        binary
*.apk        binary
*.aar        binary
*.so         binary
*.dex        binary
*.keystore   binary
*.bin        binary
*.dat        binary
*.class      binary
