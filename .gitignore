# Gradle / Android build outputs
/build/
/app/build/
/.gradle/
/app/.gradle/

# Gradle home dirs used by the PS1 test scripts
/.gradle-*/

# IDE / machine-local config (local.properties contains a user-specific SDK path)
/local.properties
/studio/local.properties
/.idea/
/studio/.idea/
/studio/.gradle/
*.iml

# Test run artifacts produced by scripts/test-*.ps1 and refresh-visual-baselines.ps1
/tmp-test-artifacts/
/tmp-test-artifacts-latest*/
/tmp-test-runs/
/tmp-recorded-latest/
/tmp-baseline-pull/
/tmp-*/
/dist/

# Ad-hoc dumps (emulator screenshots + uiautomator XML captured during debugging)
/tmp-*.png
/tmp-*.xml

# JVM crash dumps
/hs_err_pid*.log
/replay_pid*.log

# Misc
/test-fixtures/

# res/values-* locale and screen-size dirs generated from int18/ by the Makefile
/res/values-bg/
/res/values-cn/
/res/values-de/
/res/values-es/
/res/values-hu/
/res/values-it/
/res/values-pt/
/res/values-ru/
/res/values-sw600dp/
/res/values-sw720dp/


# Lint output
/lint.out
