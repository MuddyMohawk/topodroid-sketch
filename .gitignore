# Gradle / Android build outputs
/build/
/app/build/
/.gradle/
/app/.gradle/

# Gradle homes used by the PS1 test scripts
/.gradle-test-home/
/.gradle-test-home-run/
/.gradle-test-home/
/.gradle-check-home/
/.gradle-home/

# IDE / machine-local config (local.properties contains a user-specific SDK path)
/local.properties
/studio/local.properties
/.idea/
/studio/.idea/
/studio/.gradle/
*.iml

# Test run artifacts produced by scripts/test-*.ps1 and refresh-visual-baselines.ps1
/tmp-test-artifacts/
/tmp-test-artifacts-latest*/
/tmp-test-runs/
/tmp-recorded-latest/
/tmp-baseline-pull/
/tmp-*/
/dist/

# Ad-hoc dumps (emulator screenshots + uiautomator XML captured during debugging)
/tmp-*.png
/tmp-*.xml

# JVM crash dumps
/hs_err_pid*.log
/replay_pid*.log

# Misc
/test-fixtures/
